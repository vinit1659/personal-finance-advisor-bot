# ==============================================================================
# Environment Configuration Template for Personal Finance Advisor Bot
# Copy this file to '.env' and fill in your actual credentials.
# NEVER commit the active '.env' file with real keys to GitHub.
# ==============================================================================

# Google Gemini API Key
# Generated from Google AI Studio (https://aistudio.google.com/)
# Model: gemini-3.8-flash
GEMINI_API_KEY="your_gemini_api_key_here"

# Flask Server Configuration
FLASK_APP="app.py"
FLASK_ENV="development"
FLASK_DEBUG="1"
SECRET_KEY="your_flask_secret_key_change_in_production"

# Database Configuration (SQLite)
DATABASE_URL="sqlite:///database/finance.db"

# Server Port (Default: 5000 for standard Flask, or 3000 as required by hosting environment)
PORT="5000"
